# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of frontends allowed to call the API (CORS + Socket.io)
CLIENT_URLS=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/volunteer?retryWrites=true&w=majority

# --- Clerk (dashboard.clerk.com → Configure → API Keys) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Configure → Webhooks → add endpoint → "Signing Secret"
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx

# --- Cloudinary (console.cloudinary.com → Dashboard) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
